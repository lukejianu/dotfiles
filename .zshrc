# I don't want to see random new packages.
HOMEBREW_NO_UPDATE_REPORT_NEW=1

alias ls='ls -G'

alias ga='git add'
alias gb='git branch'
alias gc='git commit'
alias gco='git checkout'
alias gd='git diff'
alias glo='git log'
alias gp='git push'
alias gl='git pull'
alias grb='git rebase'
alias gst='git status'
alias gsw='git switch'

source ~/dotfiles/.kube_aliases.sh

PROMPT='%1~ %# '
